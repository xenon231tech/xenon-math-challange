# EditorConfig - Math Challenge
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{html,css,js}]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.yml,*.yaml]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[LICENSE]
insert_final_newline = false

[.gitignore]
insert_final_newline = false
